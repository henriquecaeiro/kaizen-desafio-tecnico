PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Segredo de assinatura do JWT. Gere com: npm run segredo:gerar
JWT_SEGREDO=troque-por-um-segredo-aleatorio
JWT_EXPIRACAO=7d

# Banco proprio do e-commerce (usuarios, enderecos, carrinho).
# Catalogo e pedidos NAO ficam aqui: vem do ERP.
DB_PATH=./data/ecommerce.db

# --- Integracao com o Kaizen ERP -------------------------------------------
SIAC_URL=https://teste-tecnico.kaizenautopecas.com.br
# Obrigatorio: configure localmente. Nunca versione a credencial.
SIAC_TOKEN=
ERP_TIMEOUT_MS=8000

# Origem do front em desenvolvimento (Vite). Em producao o backend serve o
# build do front e esta variavel deixa de importar.
CORS_ORIGEM=http://localhost:5173
